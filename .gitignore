# Build output (Maven; the Java extension of VS Code / Eclipse compiles to bin/)
target/
bin/
build/
*.jar
*.war
*.tar
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/

# Employee data: personal data, never in git. The server and every developer keep their own copy.
data/
photos/*
!photos/default.jpg

