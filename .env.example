# Example of .env next to docker-compose.yml (copy to .env and fill in; never commit .env).
# The SSO variables are described in docs/SSO.md, section 4.

# Alias hosts -> canonical host (CanonicalHostFilter, docs/SSO.md section 11).
# The canonical host is the one in SAML_ENTITY_ID / SAML_ACS_URL; requests for any alias host are redirected
# to it before sign-in, keeping path and query. Empty APP_CANONICAL_HOST or APP_ALIAS_HOSTS: off.
APP_CANONICAL_HOST=ccaorgchart.go1.kworld.kpmg.com
# Comma-separated, any case
APP_ALIAS_HOSTS=ccaorgchart
# 302 (default) or 301; switch to 301 only after the redirect is confirmed (browsers cache 301)
APP_ALIAS_REDIRECT_STATUS=302

# Employees from Active Directory (docs/OrgChart_AD_Integration_Spec_v2.1.md, section 8).
# Read by the application from Phase 3 on; until then these keys have no effect. The values below are the safe
# deploy defaults (spec D8): the site keeps reading Excel and the AD sync is off.
# excel | db
EMPLOYEE_SOURCE=excel
# Which AD relation builds the tree, the other one is the fallback: pm | manager
ORG_PARENT_SOURCE=pm

AD_SYNC_ENABLED=false
# mock (JSON fixture, dev) | ldap (adtest, prod)
AD_SYNC_MODE=mock
# Spring cron; "-" disables the scheduler (adtest: sync runs manually)
AD_SYNC_CRON=0 */30 * * * *
AD_SYNC_ON_STARTUP=false
# A sync that fetches fewer than this share of the current employees fails (SAFETY) and changes nothing
AD_SYNC_MIN_RATIO=0.5

# LDAPS only (port 636); host and base DN of the domain controller
AD_LDAP_URL=ldaps://<domain-controller>:636
AD_LDAP_BASE_DN=OU=Countries,OU=CCG,DC=<domain>,DC=<...>
# Read-only service account in UPN form (user@domain); the password only in the .env on the server
AD_LDAP_BIND_DN=
AD_LDAP_BIND_PASSWORD=
AD_LDAP_FILTER=(&(objectCategory=person)(objectClass=user)(|(department=Central Services*)(department=CS/*)(department=CS /*)(department=CS))(!(userAccountControl:1.2.840.113556.1.4.803:=2)))
AD_LDAP_PAGE_SIZE=500
# Truststore with the corporate CA, used only for the LDAP connection (spec 8.1); the .jks is never committed
AD_LDAP_TRUSTSTORE_PATH=
AD_LDAP_TRUSTSTORE_PASSWORD=

# One-off import of group, heads and texts from Excel into employee_overrides (Phase 5c)
OVERRIDES_IMPORT_FROM_EXCEL=false
