# Example of .env next to docker-compose.yml (copy to .env and fill in; never commit .env).
# The SSO variables are described in docs/SSO.md, section 4.

# Alias hosts -> canonical host (CanonicalHostFilter, docs/SSO.md section 11).
# The canonical host is the one in SAML_ENTITY_ID / SAML_ACS_URL; requests for any alias host are redirected
# to it before sign-in, keeping path and query. Empty APP_CANONICAL_HOST or APP_ALIAS_HOSTS: off.
APP_CANONICAL_HOST=ccaorgchart.go1.kworld.kpmg.com
# Comma-separated, any case
APP_ALIAS_HOSTS=ccaorgchart
# 302 (default) or 301; switch to 301 only after the redirect is confirmed (browsers cache 301)
APP_ALIAS_REDIRECT_STATUS=302

# Employees from Active Directory (docs/OrgChart_AD_Integration_Spec_v3.md, section 8).
# The AD_* keys are read by the AD components (AD_SYNC_MODE set). The values below are the safe deploy defaults
# (spec D8): the site keeps reading Excel and the AD sync is off.
# excel: the Excel file, as before | db: the employees synced from AD (the Excel file is then not read); setting it
# back to excel is the rollback
EMPLOYEE_SOURCE=excel
# Which AD relation builds the tree, the other one is the fallback: pm | manager
ORG_PARENT_SOURCE=pm

# true: scheduled and startup syncs; false: nothing contacts AD by itself (a SYSTEM_ADMIN can still run a dry run)
AD_SYNC_ENABLED=false
# mock (JSON fixture, dev) | ldap (adtest, prod); empty: no AD components at all (the site starts as before)
AD_SYNC_MODE=
# Spring cron; "-" disables the scheduler (adtest: sync runs once at startup)
AD_SYNC_CRON=0 */30 * * * *
# One sync after the start, in the background (dev with mock: true fills the database with the mock employees)
AD_SYNC_ON_STARTUP=false
# adtest: a dry run once after the start instead (nothing written to the database); the report (counts only, no
# personal data) goes to AD_SYNC_REPORT_PATH
AD_SYNC_STARTUP_DRY_RUN=false
AD_SYNC_REPORT_PATH=logs/ad-sync-report.json
# A sync that fetches fewer valid records than this share of the current employees fails (SAFETY) and changes
# nothing; the first sync into an empty database is not limited
AD_SYNC_MIN_RATIO=0.5

# LDAPS only (port 636); host and base DN of the domain controller
AD_LDAP_URL=ldaps://<domain-controller>:636
AD_LDAP_BASE_DN=OU=Countries,OU=CCG,DC=<domain>,DC=<...>
# Read-only service account in UPN form (user@domain); the password only in the .env on the server
AD_LDAP_BIND_DN=
AD_LDAP_BIND_PASSWORD=
AD_LDAP_FILTER=(&(objectCategory=person)(objectClass=user)(|(department=Central Services*)(department=CS/*)(department=CS /*)(department=CS))(!(userAccountControl:1.2.840.113556.1.4.803:=2))(!(sAMAccountName=copilot-*)))
AD_LDAP_PAGE_SIZE=500
# Timeouts of the LDAP connection (Spring durations: 10s, 3m): connecting, and waiting for each answer of AD
AD_LDAP_CONNECT_TIMEOUT=10s
AD_LDAP_READ_TIMEOUT=180s
# Country OUs (OU=<XX>,OU=Countries) whose employees are synced; records of other OUs (e.g. Test for Dev Team) are
# skipped and counted (spec section 4.4)
AD_LDAP_COUNTRIES=KZ,UZ,AZ,GE,AM,KG
# Truststore with the corporate CA, used only for the LDAP connection (spec 8.1); the .jks is never committed
AD_LDAP_TRUSTSTORE_PATH=
AD_LDAP_TRUSTSTORE_PASSWORD=

# Employee photos from AD thumbnailPhoto (EMPLOYEE_SOURCE=db only). Off until the information-security approval for
# storing photos: then the site shows the photo folder as before. On: after each successful sync the photos of new or
# changed employees are read (one at a time, on a background thread), validated, re-encoded as JPEG, stored in the
# database and served by GET /api/photos/{id} to signed-in users
AD_PHOTOS_ENABLED=false
# Which photo wins: ad,folder (default) or folder,ad; the initials placeholder is the last resort
PHOTO_SOURCE_PRIORITY=ad,folder
# Larger values, or images with a side above AD_PHOTOS_MAX_SIDE, are stored as INVALID (no photo)
AD_PHOTOS_MAX_BYTES=204800
AD_PHOTOS_MAX_SIDE=1024
# The photo phase of one run stops after this long; the next run continues where it stopped
AD_PHOTOS_TIME_BUDGET=120s

# One-off import of group, heads and texts from the Excel file (app.data.excel-path, read only) into
# employee_overrides (Phase 5c), once, after the first AD sync; set back to false afterwards. Undo:
#   DELETE FROM employee_overrides WHERE updated_by = 'excel-import'   (admin edits are never matched)
OVERRIDES_IMPORT_FROM_EXCEL=false
# true: everything in memory, nothing written, the same report
OVERRIDES_IMPORT_DRY_RUN=false
# The report: counts and Excel row numbers only, no names or e-mails
OVERRIDES_IMPORT_REPORT_PATH=logs/overrides-import-report.json
# More matched rows needing a manager override than this share: none is created (decide ORG_PARENT_SOURCE first)
OVERRIDES_IMPORT_MAX_MANAGER_OVERRIDE_RATIO=0.10
