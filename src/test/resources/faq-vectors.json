      "input": { "sections": [
        { "kind": "GUIDELINES", "title": "", "items": [ { "text": "ok" }, { "text": "<b>" } ] },
        { "kind": "MAILBOXES", "title": "Mail", "items": [ { "label": "", "email": "nope" } ] },
        { "kind": "QUESTIONS", "title": "Q", "items": [ { "question": "Q?", "answer": "" } ] },
        { "kind": "POEMS", "title": "x", "items": [] }
      ] },
      "errors": {
        "sections[0].title": "REQUIRED",
        "sections[0].items[1].text": "MARKUP",
        "sections[1].items[0].label": "REQUIRED",
        "sections[1].items[0].email": "EMAIL",
        "sections[2].items[0].answer": "REQUIRED",
        "sections[3].kind": "KIND"
      }
    },
    {
      "name": "too many sections and items",
      "sectionsRepeat": 13,
      "itemsRepeat": 31,
      "errors": { "sections": "TOO_MANY", "sections[0].items": "TOO_MANY" }
    }
  ]
