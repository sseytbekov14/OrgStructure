    { "kind": "line", "max": 80, "repeat": ["a", 81], "code": "TOO_LONG" },
    { "kind": "line", "max": 500, "repeat": ["a", 500], "valid": true },
    { "kind": "line", "max": 500, "repeat": ["a", 501], "code": "TOO_LONG" },
    { "kind": "text", "max": 2000, "input": "First line{NL}{NL}Second line  {NL}", "normalized": "First line{NL}{NL}Second line" },
    { "kind": "text", "max": 2000, "input": "{NL}{NL}  Answer{NL}", "normalized": "Answer" },
