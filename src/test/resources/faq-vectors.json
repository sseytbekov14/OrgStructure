{
  "description": "Shared vectors of FaqRules.java and the FAQ part of static/js/validation.js (U5). {U+XXXX} in a string stands for that character, {NL} for a line break. kind: line (one-line field), text (answer, several lines), email. A vector with 'normalized' is valid (null: empty, allowed unless required); one with 'code' is refused. 'repeat' builds long inputs: [unit, times].",
  "limits": { "title": 80, "text": 500, "label": 200, "question": 200, "answer": 2000 },
  "vectors": [
    { "kind": "line", "max": 80, "input": "Request rules", "normalized": "Request rules" },
    { "kind": "line", "max": 80, "input": "  Request{U+00A0}{U+00A0}rules{NL}today ", "normalized": "Request rules today" },
